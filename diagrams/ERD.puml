@startuml E-Commerce ERD
!define Table(name,desc) class name as "desc" << (T,#FFAAAA) >>
!define primary_key(x) <b><u>x</u></b>
!define foreign_key(x) <i>x</i>
!define unique(x) <color:green>x</color>

hide methods
hide stereotypes

' Entities
entity "users" as users {
  primary_key(id) : BIGINT
  --
  name : VARCHAR(255)
  unique(email) : VARCHAR(255)
  email_verified_at : TIMESTAMP
  password : VARCHAR(255)
  address : TEXT
  phone : VARCHAR(255)
  role : ENUM('admin','user')
  remember_token : VARCHAR(100)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "categories" as categories {
  primary_key(id) : BIGINT
  --
  name : VARCHAR(255)
  unique(slug) : VARCHAR(255)
  description : TEXT
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "products" as products {
  primary_key(id) : BIGINT
  --
  foreign_key(category_id) : BIGINT
  name : VARCHAR(255)
  unique(slug) : VARCHAR(255)
  description : TEXT
  price : DECIMAL(15,2)
  stock : INTEGER
  image : LONGTEXT
  is_active : BOOLEAN
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "orders" as orders {
  primary_key(id) : BIGINT
  --
  unique(order_code) : VARCHAR(255)
  foreign_key(user_id) : BIGINT
  total_amount : DECIMAL(15,2)
  status : ENUM('pending','paid','processing','shipped','delivered','cancelled')
  shipping_address : TEXT
  midtrans_transaction_id : VARCHAR(255)
  midtrans_payment_type : VARCHAR(255)
  snap_token : VARCHAR(255)
  resi_code : VARCHAR(255)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

entity "order_items" as order_items {
  primary_key(id) : BIGINT
  --
  foreign_key(order_id) : BIGINT
  foreign_key(product_id) : BIGINT
  quantity : INTEGER
  price : DECIMAL(15,2)
  created_at : TIMESTAMP
  updated_at : TIMESTAMP
}

' Relationships
users ||--o{ orders : "places"
orders ||--|{ order_items : "contains"
products ||--o{ order_items : "ordered in"
categories ||--o{ products : "has"

note right of users
  Role: admin or user
  Admin can manage all resources
end note

note right of orders
  Status flow:
  pending → paid → processing 
  → shipped → delivered
  Can be cancelled at any stage
end note

note right of products
  Image stored as base64
  Stock managed automatically
  on order creation
end note

@enduml
